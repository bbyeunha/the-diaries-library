---
import '@fontsource/eb-garamond/latin-400.css';
import '@fontsource/eb-garamond/latin-500.css';
import '@fontsource/eb-garamond/latin-400-italic.css';
import '@fontsource/cinzel/latin-400.css';
import '@fontsource/cinzel/latin-600.css';
import '../../styles/noesis.css';

import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoesisBackdrop from '../../components/NoesisBackdrop.astro';
import NoesisExhibit, { type ExhibitId } from '../../components/NoesisExhibit.astro';
import { formulaUrl } from '../../lib/formulas';
import { withBase } from '../../lib/site';
import { VOLUMES_1_TO_2 } from '../../data/noesis/volumes1to2';
import { VOLUMES_3_TO_5 } from '../../data/noesis/volumes3to5';
import { DESK_INTERLUDES, FORMULA_RIBBON_ITEMS } from '../../data/noesis/interludes';
import type { NoesisPlateKey } from '../../data/noesis/types';

import coverImg from '../../assets/audios/noesis/cover.jpg';
import workbenchImg from '../../assets/audios/noesis/workbench.jpg';
import eulerImg from '../../assets/audios/noesis/euler.jpg';
import vesaliusImg from '../../assets/audios/noesis/vesalius.jpg';
import harmoniaImg from '../../assets/audios/noesis/harmonia.jpg';
import connectomeImg from '../../assets/audios/noesis/connectome.jpg';
import aerodynamicsImg from '../../assets/audios/noesis/aerodynamics.jpg';
import lorenzImg from '../../assets/audios/noesis/lorenz.jpg';
import ephemerisImg from '../../assets/audios/noesis/ephemeris.jpg';
import psycheImg from '../../assets/audios/noesis/psyche.jpg';
import quantumImg from '../../assets/audios/noesis/quantum.jpg';

const chapterFormulas: Record<string, [string, string]> = { '51': ['aurelis','AURELIS 3.3'], '52': ['semantic-knowledge-integration','Semantic Knowledge Integration'], '53': ['continuum','CONTINUUM II'] };

const PLATES: Record<NoesisPlateKey, ImageMetadata> = {
  euler: eulerImg,
  vesalius: vesaliusImg,
  harmonia: harmoniaImg,
  connectome: connectomeImg,
  aerodynamics: aerodynamicsImg,
  lorenz: lorenzImg,
  ephemeris: ephemerisImg,
  psyche: psycheImg,
  quantum: quantumImg,
};

const WATERMARK_GLYPHS = [
  'ψ', '∫', 'φ', '∞', 'Δ', 'ζ', '☉', 'π', 'Ω', '∇', 'ħ', 'Γ',
];

const CHAPTER_EXHIBITS: Partial<Record<string, ExhibitId>> = {
  '02': 'logic-matrix',
  '05': 'memory-palace',
  '08': 'executive-signal',
  '11': 'syntax-tree',
  '13': 'tesseract',
  '14': 'circle-of-fifths',
  '17': 'gaussian-curve',
  '18': 'game-theory',
  '21': 'dialectic',
  '23': 'modal-venn',
  '26': 'maxwell',
  '27': 'chemistry-orbitals',
  '28': 'dna-helix',
  '30': 'action-potential',
  '33': 'compound-curve',
  '35': 'compass-rose',
  '40': 'big-o-tree',
  '42': 'perspective-grid',
  '46': 'polymath-star',
  '48': 'forgetting-curve',
  '53': 'lissajous',
};

const ALL_VOLUMES = [...VOLUMES_1_TO_2, ...VOLUMES_3_TO_5];
const OPENING_INTERLUDE = DESK_INTERLUDES.find((i) => i.afterVolumeIndex === -1);

// Confirmed YouTube URL.
const YOUTUBE_URL = 'https://www.youtube.com/watch?v=8Vh0cCdNKl0';

const pageTitle = 'NOESIS — academically insufferable. | The Diaries Library';
const pageDescription =
  'Explore the complete benefits archive of NOESIS, a bilingual affirmation audio focused on multidimensional intelligence, memory, polymathy, intellectual curiosity and foundational knowledge.';
const ogImageUrl = Astro.site ? new URL(coverImg.src, Astro.site).toString() : coverImg.src;

function buildChapterSearchText(ch: (typeof ALL_VOLUMES)[number]['chapters'][number]): string {
  const parts: string[] = [
    ch.number,
    ch.title.es,
    ch.title.en,
    ch.intro?.es || '',
    ch.intro?.en || '',
    ch.note?.es || '',
    ch.note?.en || '',
    ...(ch.items?.es || []),
    ...(ch.items?.en || []),
  ];
  if (ch.subsections) {
    for (const sub of ch.subsections) {
      parts.push(sub.title.es, sub.title.en, ...sub.items.es, ...sub.items.en);
    }
  }
  return parts
    .join(' ')
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImageUrl}
  bodyClass="page-noesis"
  defaultTheme="dark"
>
  <div class="noesis-progress" aria-hidden="true">
    <div class="noesis-progress__bar" id="noesis-progress-bar"></div>
  </div>

  <article class="noesis-universe" id="top">
    <NoesisBackdrop />

    <!-- Top Return Breadcrumb -->
    <div class="noesis-shell noesis-breadcrumb">
      <a href={withBase('/')}>
        <span aria-hidden="true">←</span>
        <span data-i18n-lang="es">Volver a The Diaries Library</span>
        <span data-i18n-lang="en">Back to The Diaries Library</span>
      </a>
      <span>PROJECT 002 · CODEX POLYMATHEIA · <a href={formulaUrl('aurelis')}> AURELIS 3.3</a></span>
    </div>

    <!-- ================================================================
         HERO — THE NOESIS ARCHIVE
         ================================================================ -->
    <header class="noesis-shell noesis-hero" aria-labelledby="noesis-title">
      <div class="noesis-hero__grid">
        <div class="noesis-hero__folio">
          <p class="noesis-hero__kicker">
            <span>THE DIARIES LIBRARY</span>
            <span aria-hidden="true">✦</span>
            <span>ARCHIVE NO. 002</span>
          </p>

          <h1 id="noesis-title" class="noesis-hero__title">NOESIS</h1>
          <p class="noesis-hero__subtitle">the art of knowing everything.</p>
          <p class="noesis-hero__public-title">
            academically insufferable. ୨ৎ intelligence, memory &amp; polymath
          </p>

          <p class="noesis-hero__epigraph">
            <span data-i18n-lang="es">
              Mi archivo personal de inteligencia humana, memoria y todo lo que me da curiosidad saber.
            </span>
            <span data-i18n-lang="en">
              An archive of human intelligence and knowledge.
            </span>
          </p>

          <dl class="noesis-hero__ledger">
            <div class="noesis-hero__ledger-item">
              <dt class="noesis-hero__ledger-label">
                <span data-i18n-lang="es">Enfoque</span>
                <span data-i18n-lang="en">Focus</span>
              </dt>
              <dd class="noesis-hero__ledger-value">Intelligence · Memory · Polymathy</dd>
            </div>
            <div class="noesis-hero__ledger-item">
              <dt class="noesis-hero__ledger-label">
                <span data-i18n-lang="es">Fórmula</span>
                <span data-i18n-lang="en">Formula</span>
              </dt>
              <dd class="noesis-hero__ledger-value"><a href={formulaUrl('aurelis')}> AURELIS 3.3</a> — <a href={formulaUrl('continuum')}> CONTINUUM II</a></dd>
            </div>
            <div class="noesis-hero__ledger-item">
              <dt class="noesis-hero__ledger-label">
                <span data-i18n-lang="es">Idiomas y Duración</span>
                <span data-i18n-lang="en">Languages &amp; Length</span>
              </dt>
              <dd class="noesis-hero__ledger-value">Español + English · 02:00</dd>
            </div>
            <div class="noesis-hero__ledger-item">
              <dt class="noesis-hero__ledger-label">
                <span data-i18n-lang="es">Qué trae adentro</span>
                <span data-i18n-lang="en">Inside the Archive</span>
              </dt>
              <dd class="noesis-hero__ledger-value">5 Volumes · 54 Chapters · <a href={formulaUrl('semantic-knowledge-integration')} aria-label="Semantic Knowledge Integration">SKI</a></dd>
            </div>
          </dl>

          <div class="noesis-hero__actions">
            <a class="noesis-btn-primary" href="#index-of-knowledge">
              <span data-i18n-lang="es">Ver los 54 capítulos</span>
              <span data-i18n-lang="en">See all 54 chapters</span>
              <span aria-hidden="true">↓</span>
            </a>

            <a class="noesis-btn-ghost" href="#authors-note">
              <span data-i18n-lang="es">Mi nota</span>
              <span data-i18n-lang="en">My note</span>
            </a>

            {YOUTUBE_URL && (
              <a
                class="noesis-btn-ghost"
                href={YOUTUBE_URL}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span data-i18n-lang="es">Escuchar en YouTube</span>
                <span data-i18n-lang="en">Listen on YouTube</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>

        <!-- Official Thumbnail + 3-Plate Study Desk Triptych -->
        <div class="noesis-hero__plates">
          <figure class="noesis-hero__main-frame">
            <Image
              src={coverImg}
              alt="NOESIS — academically insufferable. Portada renacentista con escultura clásica, mapas estelares, anatomía cerebral y esfera armilar"
              widths={[480, 800, 1280]}
              sizes="(max-width: 980px) calc(100vw - 2rem), 560px"
              format="webp"
              quality={88}
              loading="eager"
              fetchpriority="high"
              decoding="sync"
            />
            <figcaption class="noesis-hero__main-caption">
              <span>ARCHIVE 002 · ACADEMICALLY INSUFFERABLE</span>
              <span>NOESIS</span>
            </figcaption>
          </figure>

          <div class="noesis-hero__triptych">
            <figure class="noesis-hero__mini-plate">
              <Image
                src={workbenchImg}
                alt="Mesa cuántica del video original de NOESIS"
                widths={[280, 440]}
                sizes="(max-width: 980px) 42vw, 180px"
                format="webp"
                quality={82}
                loading="eager"
              />
              <figcaption>Quantum Desk · Video</figcaption>
            </figure>

            <figure class="noesis-hero__mini-plate">
              <Image
                src={eulerImg}
                alt="Manuscrito histórico de cálculo de Leonhard Euler"
                widths={[280, 440]}
                sizes="(max-width: 980px) 42vw, 180px"
                format="webp"
                quality={82}
                loading="eager"
              />
              <figcaption>Euler · Manuscript</figcaption>
            </figure>

            <figure class="noesis-hero__mini-plate">
              <Image
                src={harmoniaImg}
                alt="Atlas celeste Harmonia Macrocosmica de Andreas Cellarius, 1660"
                widths={[280, 440]}
                sizes="(max-width: 980px) 84vw, 180px"
                format="webp"
                quality={82}
                loading="eager"
              />
              <figcaption>Cellarius · 1660</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </header>

    <!-- Full-Width Formula & Axiom Desk Strip -->
    <div class="noesis-formula-strip" aria-label="Fórmulas y axiomas de la mesa de trabajo">
      <div class="noesis-shell noesis-formula-strip__grid">
        {FORMULA_RIBBON_ITEMS.map((item) => (
          <span class="noesis-formula-chip">
            <span class="noesis-formula-chip__tag">{item.label}</span>
            <span class="noesis-formula-chip__eq" set:html={item.html} />
          </span>
        ))}
      </div>
    </div>

    <!-- ================================================================
         AUTHOR'S NOTE + DESK COMPASS FOLIO
         ================================================================ -->
    <section class="noesis-shell noesis-note-section" id="authors-note" aria-labelledby="authors-note-heading">
      <div class="noesis-note-spread">
        <div class="noesis-note-card">
          <h2 id="authors-note-heading" class="noesis-section-eyebrow">
            <span data-i18n-lang="es">De mí para ti · bbyeunha</span>
            <span data-i18n-lang="en">From my desk · bbyeunha</span>
          </h2>

          <div class="noesis-note__body" data-i18n-lang="es" lang="es">
            <p>holiii, probablemente este sea uno de los audios que más ilusión me ha hecho crear.</p>
            <p>
              siempre he querido ser esa persona que sabe un poquito de absolutamente todo, que puede participar en cualquier conversación y que encuentra interesante hasta el tema más inesperado JAJAJA.
            </p>
            <p>así que decidí hacer un audio para eso.</p>
            <p>
              noesis nació de mi fascinación por la inteligencia, la memoria, la curiosidad y la polimatía. quería explorar diferentes formas de inteligencia y reunir la mayor cantidad posible de disciplinas dentro de un mismo audio.
            </p>
            <p>
              además de las afirmaciones habituales, incluí pequeñas definiciones y conocimientos reales de diferentes áreas, desde filosofía y matemáticas hasta neurociencia, astronomía, economía, arte y aviación.
            </p>
            <p>
              este es también el primer audio desarrollado con <a href={formulaUrl('aurelis')}> AURELIS 3.3</a>, una fórmula experimental que he creado para mis propios audios, con afirmaciones absurdamente detalladas y refuerzos integrados.
            </p>
            <p>
              como siempre, lo hice principalmente para mí y decidí compartirlo por amor al arte. espero que disfruten explorando este pequeño archivo de conocimiento tanto como yo disfruté creándolo. ♡
            </p>
          </div>

          <div class="noesis-note__body" data-i18n-lang="en" lang="en">
            <p>hiii, this is probably one of the audios i've been most excited to create.</p>
            <p>
              i've always wanted to be the kind of person who knows a little bit about absolutely everything, who can jump into any conversation and find even the most random, unexpected topics fascinating lol.
            </p>
            <p>so i decided to make an audio for exactly that.</p>
            <p>
              noesis came straight out of my obsession with intelligence, memory, curiosity, and polymathy. i wanted to explore all kinds of intelligence and pack as many disciplines as humanly possible into one single audio.
            </p>
            <p>
              on top of regular affirmations, i slipped in short definitions and real foundational concepts from all over the map—from philosophy and math to neuroscience, astronomy, economics, art, and aviation.
            </p>
            <p>
              this is also my very first audio built on <a href={formulaUrl('aurelis')}> AURELIS 3.3</a>, an experimental formula i designed for my own audios with ridiculously detailed affirmations and built-in boosters.
            </p>
            <p>
              as always, i made it mainly for myself and decided to put it out there just for the love of the craft. hope you have as much fun digging through this little knowledge archive as i had making it. ♡
            </p>
          </div>
        </div>

        <!-- Companion Archival Dossier Summary -->
        <aside class="noesis-note-aside" aria-label="Ficha del códice NOESIS">
          <div>
            <p class="noesis-section-eyebrow">
              <span>EX LIBRIS · 002</span>
            </p>
            <svg class="noesis-note-aside__seal" viewBox="0 0 180 180" fill="none" aria-hidden="true">
              <circle cx="90" cy="90" r="82" stroke="currentColor" stroke-width="1" />
              <circle cx="90" cy="90" r="68" stroke="currentColor" stroke-width="0.7" stroke-dasharray="3 5" />
              <polygon points="90,14 156,128 24,128" stroke="currentColor" stroke-width="0.9" />
              <polygon points="90,166 156,52 24,52" stroke="currentColor" stroke-width="0.9" />
              <circle cx="90" cy="90" r="22" stroke="currentColor" stroke-width="0.9" />
              <text x="90" y="94" text-anchor="middle" fill="currentColor" font-size="11" font-family="Cinzel, serif" letter-spacing="3">
                NOESIS
              </text>
            </svg>
          </div>

          <ul class="noesis-note-aside__list">
            <li><strong>VOLUMES</strong><span>V (I – V)</span></li>
            <li><strong>CHAPTERS</strong><span>54 Folios</span></li>
            <li><strong>SYSTEM</strong><span>AURELIS 3.3</span></li>
            <li><strong>BOOSTER</strong><span>CONTINUUM II</span></li>
            <li><strong>LAYER</strong><span>Semantic Knowledge</span></li>
            <li><strong>LANGUAGES</strong><span>Español + English</span></li>
          </ul>
        </aside>
      </div>
    </section>

    <!-- ================================================================
         INDEX OF KNOWLEDGE + 5 VOLUMES (54 CHAPTERS) + SCROLL INTERLUDES
         ================================================================ -->
    <div class="noesis-shell noesis-workspace" id="index-of-knowledge">
      <!-- Sticky Desktop Sidebar Index -->
      <aside class="noesis-sidebar" aria-label="Index of Knowledge">
        <h2 class="noesis-sidebar__title">
          <span data-i18n-lang="es">Índice del Archivo</span>
          <span data-i18n-lang="en">Index of Knowledge</span>
          <span>54</span>
        </h2>

        <p class="noesis-sidebar__formula">
          |ψ⟩ = α|0⟩ + βe<sup>iφ</sup>|1⟩ · ☉ △ ♃
        </p>

        {ALL_VOLUMES.map((vol, vIdx) => (
          <details class="noesis-index-vol" open={vIdx === 0}>
            <summary>
              <span>VOL. {vol.roman} ({vol.chapters.length})</span>
            </summary>
            <ol class="noesis-index-list">
              <li>
                <a href={`#${vol.id}`}>
                  <span class="noesis-index-num">{vol.roman}</span>
                  <span data-i18n-lang="es">{vol.title.es.replace(/^Volume [IVX]+ — /, '')}</span>
                  <span data-i18n-lang="en">{vol.title.en.replace(/^Volume [IVX]+ — /, '')}</span>
                </a>
              </li>
              {vol.chapters.map((ch) => (
                <li>
                  <a href={`#${ch.id}`}>
                    <span class="noesis-index-num">{ch.number}</span>
                    <span data-i18n-lang="es">{ch.title.es}</span>
                    <span data-i18n-lang="en">{ch.title.en}</span>
                  </a>
                </li>
              ))}
            </ol>
          </details>
        ))}
      </aside>

      <!-- Main Encyclopedia Content Column -->
      <div class="noesis-content">
        <!-- Mobile Collapsible Index -->
        <details class="noesis-mobile-index" id="noesis-mobile-index">
          <summary>
            <span data-i18n-lang="es">Índice del Archivo · 5 Volúmenes · 54 Capítulos</span>
            <span data-i18n-lang="en">Index of Knowledge · 5 Volumes · 54 Chapters</span>
          </summary>
          <div class="noesis-mobile-index__body">
            {ALL_VOLUMES.map((vol) => (
              <details class="noesis-index-vol">
                <summary>
                  <span>VOL. {vol.roman} — {vol.chapters.length}</span>
                </summary>
                <ol class="noesis-index-list">
                  <li>
                    <a href={`#${vol.id}`} data-mobile-nav-link>
                      <span class="noesis-index-num">{vol.roman}</span>
                      <span data-i18n-lang="es">{vol.title.es.replace(/^Volume [IVX]+ — /, '')}</span>
                      <span data-i18n-lang="en">{vol.title.en.replace(/^Volume [IVX]+ — /, '')}</span>
                    </a>
                  </li>
                  {vol.chapters.map((ch) => (
                    <li>
                      <a href={`#${ch.id}`} data-mobile-nav-link>
                        <span class="noesis-index-num">{ch.number}</span>
                        <span data-i18n-lang="es">{ch.title.es}</span>
                        <span data-i18n-lang="en">{ch.title.en}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </details>
            ))}
          </div>
        </details>

        <!-- Sticky Search + Expand / Collapse Controls -->
        <div class="noesis-controls" role="region" aria-label="Herramientas de lectura">
          <div class="noesis-search-wrap">
            <label class="sr-only" for="noesis-search">
              <span data-i18n-lang="es">Buscar beneficios, capítulos o disciplinas</span>
              <span data-i18n-lang="en">Search benefits, chapters or disciplines</span>
            </label>
            <input
              id="noesis-search"
              type="search"
              class="noesis-search-input"
              placeholder="Buscar tema, capítulo o palabra..."
              data-placeholder-es="Buscar tema, capítulo o palabra..."
              data-placeholder-en="Search topic, chapter or keyword..."
              autocomplete="off"
            />
            <button
              type="button"
              id="noesis-search-clear"
              class="noesis-search-clear"
              aria-label="Limpiar búsqueda"
              hidden
            >
              <span aria-hidden="true">×</span>
            </button>
          </div>

          <span class="noesis-search-status" id="noesis-search-status" aria-live="polite">
            <span data-i18n-lang="es">54 capítulos</span>
            <span data-i18n-lang="en">54 chapters</span>
          </span>

          <div class="noesis-control-btns">
            <button type="button" class="noesis-ctrl-btn" id="noesis-expand-all">
              <span data-i18n-lang="es">Abrir todo</span>
              <span data-i18n-lang="en">Expand all</span>
            </button>
            <button type="button" class="noesis-ctrl-btn" id="noesis-collapse-all">
              <span data-i18n-lang="es">Cerrar todo</span>
              <span data-i18n-lang="en">Collapse all</span>
            </button>
          </div>
        </div>

        <!-- Opening Desk Interlude before Volume I -->
        {OPENING_INTERLUDE && (
          <aside class="noesis-interlude" data-noesis-interlude aria-label={OPENING_INTERLUDE.tag}>
            <div class="noesis-interlude__art" aria-hidden="true">
              <svg viewBox="0 0 150 150" fill="none">
                <circle cx="75" cy="75" r="62" stroke="currentColor" stroke-width="0.9" stroke-dasharray="3 5" />
                <circle cx="75" cy="75" r="36" stroke="currentColor" stroke-width="0.9" />
                <line x1="25" y1="55" x2="75" y2="39" stroke="currentColor" stroke-width="1" />
                <line x1="75" y1="39" x2="124" y2="58" stroke="currentColor" stroke-width="1" />
                <line x1="124" y1="58" x2="108" y2="112" stroke="currentColor" stroke-width="1" />
                <line x1="108" y1="112" x2="42" y2="112" stroke="currentColor" stroke-width="1" />
                <line x1="42" y1="112" x2="25" y2="55" stroke="currentColor" stroke-width="1" />
                <line x1="25" y1="55" x2="108" y2="112" stroke="currentColor" stroke-width="0.7" opacity="0.65" />
                <line x1="124" y1="58" x2="42" y2="112" stroke="currentColor" stroke-width="0.7" opacity="0.65" />
                <circle cx="25" cy="55" r="3.5" fill="currentColor" />
                <circle cx="75" cy="39" r="3.5" fill="currentColor" />
                <circle cx="124" cy="58" r="3.5" fill="currentColor" />
                <circle cx="108" cy="112" r="3.5" fill="currentColor" />
                <circle cx="42" cy="112" r="3.5" fill="currentColor" />
                <circle cx="75" cy="75" r="4.5" fill="currentColor" />
              </svg>
            </div>
            <div>
              <p class="noesis-interlude__tag">{OPENING_INTERLUDE.tag}</p>
              <blockquote class="noesis-interlude__quote">
                <span data-i18n-lang="es">{OPENING_INTERLUDE.quote.es}</span>
                <span data-i18n-lang="en">{OPENING_INTERLUDE.quote.en}</span>
              </blockquote>
              <p class="noesis-interlude__author">— {OPENING_INTERLUDE.author}</p>
              <div class="noesis-interlude__formula-box">
                <span class="noesis-interlude__formula-label">{OPENING_INTERLUDE.formulaLabel}</span>
                <span class="noesis-interlude__formula-eq" set:html={OPENING_INTERLUDE.formulaHtml} />
              </div>
              <p class="noesis-interlude__marginalia">
                <span data-i18n-lang="es">{OPENING_INTERLUDE.marginalia.es}</span>
                <span data-i18n-lang="en">{OPENING_INTERLUDE.marginalia.en}</span>
              </p>
            </div>
          </aside>
        )}

        <!-- 5 Volumes & 54 Chapters + Visual Constellation Friezes + Interleaved Folios -->
        {ALL_VOLUMES.map((vol, volIdx) => {
          const nextInterlude = DESK_INTERLUDES.find((i) => i.afterVolumeIndex === volIdx);

          return (
            <>
              <section class="noesis-volume" id={vol.id} data-noesis-volume aria-labelledby={`${vol.id}-heading`}>
                <header class="noesis-volume__header">
                  <span class="noesis-volume__roman">VOLUME {vol.roman} · CODEX NOESIS</span>
                  <div class="noesis-volume__title-row">
                    <h2 id={`${vol.id}-heading`} class="noesis-volume__title">
                      <span data-i18n-lang="es">{vol.title.es.replace(/^Volume [IVX]+ — /, '')}</span>
                      <span data-i18n-lang="en">{vol.title.en.replace(/^Volume [IVX]+ — /, '')}</span>
                    </h2>
                    <button
                      type="button"
                      class="noesis-anchor-btn"
                      data-copy-anchor={`#${vol.id}`}
                      aria-label={`Copiar enlace a Volume ${vol.roman}`}
                    >
                      #
                    </button>
                  </div>
                  <p class="noesis-volume__subtitle">
                    <span data-i18n-lang="es">{vol.subtitle.es}</span>
                    <span data-i18n-lang="en">{vol.subtitle.en}</span>
                  </p>
                  {vol.epigraph && (
                    <p class="noesis-volume__disclaimer">
                      <span data-i18n-lang="es">{vol.epigraph.es}</span>
                      <span data-i18n-lang="en">{vol.epigraph.en}</span>
                    </p>
                  )}
                  {vol.disclaimer && (
                    <p class="noesis-volume__disclaimer">
                      <span data-i18n-lang="es">{vol.disclaimer.es}</span>
                      <span data-i18n-lang="en">{vol.disclaimer.en}</span>
                    </p>
                  )}
                </header>

                <div class="noesis-chapters">
                  {vol.chapters.map((ch) => {
                    const searchCorpus = buildChapterSearchText(ch);
                    const plateImage = ch.plate ? PLATES[ch.plate.key] : undefined;
                    const glyph = WATERMARK_GLYPHS[parseInt(ch.number, 10) % WATERMARK_GLYPHS.length];
                    const isAviation = ch.number === '45';
                    const exhibitKind = CHAPTER_EXHIBITS[ch.number];

                    return (
                      <>
                        <details
                          class="noesis-chapter"
                          id={ch.id}
                          data-noesis-chapter
                          data-search={searchCorpus}
                          open
                        >
                          <summary class="noesis-chapter__summary">
                            <div class="noesis-chapter__heading">
                              <span class="noesis-chapter__num">CH. {ch.number}</span>
                              <h3 class="noesis-chapter__title">
                                <span data-i18n-lang="es">{ch.title.es}</span>
                                <span data-i18n-lang="en">{ch.title.en}</span>
                              </h3>
                            </div>

                            <div class="noesis-chapter__meta-actions">
                              <button
                                type="button"
                                class="noesis-anchor-btn"
                                data-copy-anchor={`#${ch.id}`}
                                aria-label={`Copiar enlace al capítulo ${ch.number}`}
                              >
                                #
                              </button>
                              <span class="noesis-chapter__chevron" aria-hidden="true"></span>
                            </div>
                          </summary>

                          <div class="noesis-chapter__body">
                            {chapterFormulas[ch.number] && <a href={formulaUrl(chapterFormulas[ch.number][0])}>{chapterFormulas[ch.number][1]} →</a>}
                            {ch.intro && (
                              <p class={isAviation ? 'noesis-author-whisper' : 'noesis-chapter__intro'}>
                                <span data-i18n-lang="es">{ch.intro.es}</span>
                                <span data-i18n-lang="en">{ch.intro.en}</span>
                              </p>
                            )}

                            {ch.items && (
                              <>
                                <ul class="noesis-chapter__list" data-i18n-lang="es" lang="es">
                                  {ch.items.es.map((item) => (
                                    <li>{item}</li>
                                  ))}
                                </ul>
                                <ul class="noesis-chapter__list" data-i18n-lang="en" lang="en">
                                  {ch.items.en.map((item) => (
                                    <li>{item}</li>
                                  ))}
                                </ul>
                              </>
                            )}

                            {ch.subsections && (
                              <div class="noesis-subsections">
                                {ch.subsections.map((sub) => (
                                  <div class="noesis-subsection">
                                    <h4 class="noesis-subsection__title">
                                      <span data-i18n-lang="es">{sub.title.es}</span>
                                      <span data-i18n-lang="en">{sub.title.en}</span>
                                    </h4>
                                    <ul class="noesis-chapter__list" data-i18n-lang="es" lang="es">
                                      {sub.items.es.map((item) => (
                                        <li>{item}</li>
                                      ))}
                                    </ul>
                                    <ul class="noesis-chapter__list" data-i18n-lang="en" lang="en">
                                      {sub.items.en.map((item) => (
                                        <li>{item}</li>
                                      ))}
                                    </ul>
                                  </div>
                                ))}
                              </div>
                            )}

                            {ch.note && (
                              <p class="noesis-chapter__note">
                                <span data-i18n-lang="es">{ch.note.es}</span>
                                <span data-i18n-lang="en">{ch.note.en}</span>
                              </p>
                            )}

                            {ch.plate && plateImage && (
                              <figure class="noesis-plate">
                                <Image
                                  src={plateImage}
                                  alt={ch.plate.alt.es}
                                  widths={[360, 640]}
                                  sizes="(max-width: 680px) calc(100vw - 4rem), 320px"
                                  format="webp"
                                  quality={82}
                                  loading="lazy"
                                  decoding="async"
                                />
                                <figcaption class="noesis-plate__meta">
                                  <span class="noesis-plate__fig">{ch.plate.figure}</span>
                                  <p class="noesis-plate__caption">
                                    <span data-i18n-lang="es">{ch.plate.caption.es}</span>
                                    <span data-i18n-lang="en">{ch.plate.caption.en}</span>
                                  </p>
                                </figcaption>
                              </figure>
                            )}
                          </div>

                          <span class="noesis-chapter__watermark" aria-hidden="true">{glyph}</span>
                        </details>
                        {exhibitKind && <NoesisExhibit kind={exhibitKind} />}
                      </>
                    );
                  })}
                </div>
              </section>

              {nextInterlude && (
                <aside class="noesis-interlude" data-noesis-interlude aria-label={nextInterlude.tag}>
                  <div class="noesis-interlude__art" aria-hidden="true">
                    {nextInterlude.svgKind === 'feynman' && (
                      <svg viewBox="0 0 150 150" fill="none">
                        <line x1="14" y1="30" x2="46" y2="75" stroke="currentColor" stroke-width="1.5" />
                        <line x1="14" y1="120" x2="46" y2="75" stroke="currentColor" stroke-width="1.5" />
                        <path d="M 46 75 Q 52 63, 58 75 T 70 75" stroke="currentColor" stroke-width="1.5" />
                        <circle cx="82" cy="75" r="12" stroke="currentColor" stroke-width="1.4" />
                        <path d="M 94 75 Q 100 63, 106 75 T 118 75" stroke="currentColor" stroke-width="1.5" />
                        <line x1="118" y1="75" x2="138" y2="30" stroke="currentColor" stroke-width="1.5" />
                        <line x1="118" y1="75" x2="138" y2="120" stroke="currentColor" stroke-width="1.5" />
                        <circle cx="46" cy="75" r="3" fill="currentColor" />
                        <circle cx="118" cy="75" r="3" fill="currentColor" />
                        <text x="66" y="45" fill="currentColor" font-size="11" font-style="italic">γ* / Z⁰</text>
                      </svg>
                    )}
                    {nextInterlude.svgKind === 'astrolabe' && (
                      <svg viewBox="0 0 150 150" fill="none">
                        <circle cx="75" cy="75" r="64" stroke="currentColor" stroke-width="1.1" />
                        <circle cx="75" cy="75" r="50" stroke="currentColor" stroke-width="0.8" stroke-dasharray="3 4" />
                        <circle cx="75" cy="75" r="24" stroke="currentColor" stroke-width="0.8" />
                        <polygon points="75,18 124,103 26,103" stroke="currentColor" stroke-width="1.1" />
                        <polygon points="75,132 124,47 26,47" stroke="currentColor" stroke-width="0.9" opacity="0.7" />
                        <circle cx="75" cy="18" r="3" fill="currentColor" />
                        <circle cx="124" cy="103" r="3" fill="currentColor" />
                        <circle cx="26" cy="103" r="3" fill="currentColor" />
                      </svg>
                    )}
                    {nextInterlude.svgKind === 'golden' && (
                      <svg viewBox="0 0 150 150" fill="none">
                        <rect x="14" y="34" width="122" height="76" stroke="currentColor" stroke-width="1" />
                        <line x1="90" y1="34" x2="90" y2="110" stroke="currentColor" stroke-width="0.8" />
                        <line x1="90" y1="80" x2="136" y2="80" stroke="currentColor" stroke-width="0.8" />
                        <path d="M 14 110 A 76 76 0 0 1 90 34 A 46 46 0 0 1 136 80 A 30 30 0 0 1 106 110" stroke="currentColor" stroke-width="1.5" />
                        <text x="64" y="136" fill="currentColor" font-size="11" font-style="italic">φ = 1.618</text>
                      </svg>
                    )}
                    {nextInterlude.svgKind === 'wavepacket' && (
                      <svg viewBox="0 0 150 150" fill="none">
                        <line x1="10" y1="75" x2="140" y2="75" stroke="currentColor" stroke-width="0.7" opacity="0.5" />
                        <path d="M 12 75 Q 24 72, 32 75 T 48 64 T 62 96 T 75 34 T 88 116 T 102 58 T 118 82 T 138 75" stroke="currentColor" stroke-width="1.6" />
                        <circle cx="75" cy="75" r="56" stroke="currentColor" stroke-width="0.7" stroke-dasharray="2 5" />
                        <text x="48" y="138" fill="currentColor" font-size="10" font-style="italic">|ψ(x,t)|²</text>
                      </svg>
                    )}
                  </div>
                  <div>
                    <p class="noesis-interlude__tag">{nextInterlude.tag}</p>
                    <blockquote class="noesis-interlude__quote">
                      <span data-i18n-lang="es">{nextInterlude.quote.es}</span>
                      <span data-i18n-lang="en">{nextInterlude.quote.en}</span>
                    </blockquote>
                    <p class="noesis-interlude__author">— {nextInterlude.author}</p>
                    <div class="noesis-interlude__formula-box">
                      <span class="noesis-interlude__formula-label">{nextInterlude.formulaLabel}</span>
                      <span class="noesis-interlude__formula-eq" set:html={nextInterlude.formulaHtml} />
                    </div>
                    <p class="noesis-interlude__marginalia">
                      <span data-i18n-lang="es">{nextInterlude.marginalia.es}</span>
                      <span data-i18n-lang="en">{nextInterlude.marginalia.en}</span>
                    </p>
                  </div>
                </aside>
              )}
            </>
          );
        })}

        <p class="noesis-empty-search" id="noesis-empty-search" hidden>
          <span data-i18n-lang="es">No encontré ningún capítulo con esa palabra.</span>
          <span data-i18n-lang="en">Couldn’t find any chapters matching that.</span>
        </p>
      </div>
    </div>

    <!-- ================================================================
         CLOSING PAGE — Classical Colophon
         ================================================================ -->
    <footer class="noesis-shell noesis-colophon">
      <div class="noesis-colophon__ornament" aria-hidden="true">✦ · ✦ · ✦</div>
      <p class="noesis-colophon__quote">made for myself, shared with love.</p>
      <p class="noesis-colophon__author">— bbyeunha</p>

      <div class="noesis-colophon__links">
        <a class="noesis-btn-primary" href={withBase('/')}>
          <span aria-hidden="true">←</span>
          <span data-i18n-lang="es">Volver a The Diaries Library</span>
          <span data-i18n-lang="en">Back to The Diaries Library</span>
        </a>
        <a class="noesis-btn-ghost" href="#index-of-knowledge">
          <span data-i18n-lang="es">Subir al índice</span>
          <span data-i18n-lang="en">Back to index</span>
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </footer>
  </article>

  <script is:inline>
    (() => {
      const progressBar = document.getElementById('noesis-progress-bar');
      const searchInput = document.getElementById('noesis-search');
      const clearBtn = document.getElementById('noesis-search-clear');
      const statusEl = document.getElementById('noesis-search-status');
      const emptyEl = document.getElementById('noesis-empty-search');
      const expandAllBtn = document.getElementById('noesis-expand-all');
      const collapseAllBtn = document.getElementById('noesis-collapse-all');
      const mobileIndex = document.getElementById('noesis-mobile-index');

      const chapters = Array.from(document.querySelectorAll('[data-noesis-chapter]'));
      const volumes = Array.from(document.querySelectorAll('[data-noesis-volume]'));
      const interludes = Array.from(document.querySelectorAll('[data-noesis-interlude]'));
      const exhibits = Array.from(document.querySelectorAll('[data-noesis-exhibit]'));

      function updateProgress() {
        if (!progressBar) return;
        const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const pct = Math.min(100, Math.max(0, (window.scrollY / max) * 100));
        progressBar.style.width = `${pct.toFixed(2)}%`;
      }
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();

      function normalize(str) {
        return (str || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .trim();
      }

      function updateSearch() {
        if (!searchInput) return;
        const q = normalize(searchInput.value);
        if (clearBtn) clearBtn.hidden = q.length === 0;

        let visibleChapters = 0;
        chapters.forEach((ch) => {
          const corpus = ch.getAttribute('data-search') || '';
          const match = !q || corpus.includes(q);
          ch.hidden = !match;
          if (match) {
            visibleChapters += 1;
            if (q) ch.open = true;
          }
        });

        volumes.forEach((vol) => {
          const anyVisible = Array.from(vol.querySelectorAll('[data-noesis-chapter]')).some(
            (c) => !c.hidden
          );
          vol.hidden = !anyVisible;
        });

        interludes.forEach((el) => {
          el.hidden = q.length > 0;
        });
        exhibits.forEach((el) => {
          el.hidden = q.length > 0;
        });

        if (emptyEl) emptyEl.hidden = visibleChapters > 0;
        if (statusEl) {
          const esSpan = statusEl.querySelector('[data-i18n-lang="es"]');
          const enSpan = statusEl.querySelector('[data-i18n-lang="en"]');
          if (esSpan) esSpan.textContent = `${visibleChapters} ${visibleChapters === 1 ? 'capítulo' : 'capítulos'}`;
          if (enSpan) enSpan.textContent = `${visibleChapters} ${visibleChapters === 1 ? 'chapter' : 'chapters'}`;
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', updateSearch);
      }
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          if (!searchInput) return;
          searchInput.value = '';
          searchInput.focus();
          updateSearch();
        });
      }

      if (expandAllBtn) {
        expandAllBtn.addEventListener('click', () => {
          chapters.forEach((ch) => {
            if (!ch.hidden) ch.open = true;
          });
        });
      }
      if (collapseAllBtn) {
        collapseAllBtn.addEventListener('click', () => {
          chapters.forEach((ch) => {
            if (!ch.hidden) ch.open = false;
          });
        });
      }

      document.querySelectorAll('[data-mobile-nav-link]').forEach((link) => {
        link.addEventListener('click', () => {
          if (mobileIndex) mobileIndex.open = false;
          const href = link.getAttribute('href') || '';
          if (href.startsWith('#')) {
            const target = document.getElementById(href.slice(1));
            if (target && target.tagName === 'DETAILS') target.open = true;
          }
        });
      });

      if (window.location.hash) {
        const hashTarget = document.getElementById(window.location.hash.slice(1));
        if (hashTarget && hashTarget.tagName === 'DETAILS') hashTarget.open = true;
      }

      document.querySelectorAll('[data-copy-anchor]').forEach((btn) => {
        btn.addEventListener('click', async (ev) => {
          ev.preventDefault();
          ev.stopPropagation();
          const hash = btn.getAttribute('data-copy-anchor') || '';
          const url = `${window.location.origin}${window.location.pathname}${hash}`;
          try {
            await navigator.clipboard.writeText(url);
          } catch {
            window.location.hash = hash;
          }
          const orig = btn.textContent;
          btn.textContent = '✓';
          setTimeout(() => {
            btn.textContent = orig;
          }, 1200);
        });
      });
    })();
  </script>
</BaseLayout>
