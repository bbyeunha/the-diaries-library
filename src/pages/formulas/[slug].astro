---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Words from '../../components/Words.astro';
import FormulaCredit from '../../components/FormulaCredit.astro';
import { formulas, formulaUrl, artwork, relatedAudios, appliedArchitectures } from '../../lib/formulas';
import { withBase } from '../../lib/site';
import '../../styles/formulas.css';
export function getStaticPaths(){return formulas.map(f => ({ params:{slug:f.slug}, props:{f} }));}
const { f } = Astro.props;
const audios=relatedAudios(f.slug,await getCollection('audios'));
const [ink,shadow,rule,accent,pale,paper]=f.colors;
const light={bg:paper,surface:pale,text:ink,muted:shadow,accent:shadow,accentSoft:shadow,border:rule};
const dark={bg:ink,surface:shadow,text:paper,muted:pale,accent:pale,accentSoft:accent,border:rule};
const image=artwork(f.slug);
const appliedProjects = Object.entries(appliedArchitectures).filter(([, project]) => Object.hasOwn(project.parts, f.slug));
const subjects = [
  ['Lógica y epistemología','Logic and epistemology'],['Filosofía','Philosophy'],['Matemáticas','Mathematics'],['Física','Physics'],['Química','Chemistry'],['Biología','Biology'],['Anatomía y fisiología','Anatomy and physiology'],['Neurociencia','Neuroscience'],['Psicología','Psychology'],['Economía y finanzas','Economics and finance'],['Historia','History'],['Geografía y geopolítica','Geography and geopolitics'],['Ciencia política','Political science'],['Derecho','Law'],['Astronomía','Astronomy'],['Ingeniería','Engineering'],['Informática','Computer science'],['Lingüística','Linguistics'],['Arte','Art'],['Música','Music'],['Literatura','Literature'],['Aviación','Aviation']
];
---
<BaseLayout title={f.name+' — '+f.subtitle+' | The Diaries Library'} description={f.philosophy[0].es+' '+f.philosophy[0].en} ogImage={new URL(image.src,Astro.site).href} pageTheme={{name:f.name,coverLayout:'spread',light,dark}}>
<article class="shell archive dossier" data-edition={f.slug}>
<a class="back-link" href={withBase('/formulas/')}><Words es="← Archivo de fórmulas" en="← The Formula Archives"/></a>
<header class="folio"><div><p class="classification"><Words {...f.category}/> {f.version && ' · '+f.version}</p><h1>{f.name}</h1><p class="motto">{f.subtitle}</p>{f.identity && <p>{f.identity}</p>}</div>
<figure><Image src={image} alt={f.art.title} widths={[400,700,1000]} sizes="(max-width: 680px) 90vw, 480px" format="webp"/><figcaption><a href={'https://www.clevelandart.org/art/'+f.art.id}>{f.art.title}</a> · Cleveland Museum of Art · CC0</figcaption></figure></header>
<div class="reading-layout">
<aside class="contents"><h2><Words es="En estas páginas" en="In these pages"/></h2>
<ol>{f.principles.map(p=><li><a href={'#'+p.id}><Words {...p.label}/></a></li>)}</ol></aside>
<div class="manuscript"><p class="opening"><Words {...f.philosophy[0]}/></p>
{f.slug==='aurelis' && <figure class="radial"><span><Words es="Memoria" en="Memory"/></span><span><Words es="Lenguaje" en="Language"/></span><strong><Words es="Inteligencia" en="Intelligence"/></strong><span><Words es="Creatividad" en="Creativity"/></span><span><Words es="Razonamiento" en="Reasoning"/></span></figure>}
{f.slug==='syneris' && <blockquote><Words es="¿Qué me gusta de él y qué quiero vivir yo?" en="What do I like about him, and what do I want that to feel like for me?"/></blockquote>}
{f.principles.map((p,i)=><section id={p.id} class="passage"><h2><Words {...p.label}/></h2><p><Words {...p.text}/></p>
{f.slug==='aurelis' && i===6 && <aside class="pencil"><Words es="Algunas cosas me cuesta imaginarlas hasta que encuentro la palabra justa." en="Some things only click for me once I find the right word."/></aside>}
{f.slug==='semantic-knowledge-integration' && i===6 && <dl class="contrast"><div><dt><Words es="Una capacidad" en="An ability"/></dt><dd><Words es="Qué hago cuando razono." en="What I do when I reason."/></dd></div><div><dt><Words es="Un concepto" en="A concept"/></dt><dd><Words es="Sobre qué estoy razonando." en="What I’m reasoning about."/></dd></div></dl>}
{f.slug==='semantic-knowledge-integration' && i===7 && <><ul class="subject-map">{subjects.map(([es,en])=><li><Words es={es} en={en}/></li>)}</ul><a href={withBase('/audios/noesis/')+'#volume-iii'}>Volume III — The Encyclopedia of Human Knowledge →</a></>}
</section>)}</div></div>
{f.version && <section><h2><Words es="Versión pública" en="Public version"/></h2><p>{f.short} {f.version}{f.slug==='aurelis' && <> · <Words es="La estrené en NOESIS." en="I first used it in NOESIS."/></>}</p></section>}

<section><h2><Words es="En mis audios" en="In my audios"/></h2>
{audios.map(audio=><a class="audio-ref" href={withBase('/audios/'+audio.id+'/')}><Image src={audio.data.cover} alt="" width={240} format="webp"/><span><small>{audio.data.series==='NOESIS'?'NOESIS':audio.data.code} · <Words {...audio.data.category}/></small><strong>{audio.data.title} ↗</strong>{audio.data.formulaRefs.find(ref=>ref.slug===f.slug)?.version}</span></a>)}</section>
{f.related.length>0 && <section><h2><Words es="Arquitecturas y técnicas relacionadas" en="Related architectures and techniques"/></h2>{f.related.map(slug=><p><a href={formulaUrl(slug)}>{formulas.find(item=>item.slug===slug)?.name} →</a></p>)}</section>}
{appliedProjects.length > 0 && <section>
  <h2><Words es="Dónde lo apliqué" en="Where I used it" /></h2>
  {appliedProjects.map(([slug, project]) => <p><a href={formulaUrl(slug)}>{project.name} · <Words {...project.category} /> →</a></p>)}
</section>}
<FormulaCredit/><a class="back-link" href={withBase('/')}><Words es="← Volver a la biblioteca" en="← Back to the library"/></a></article></BaseLayout>
